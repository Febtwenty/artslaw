{
  "name": "artslaw-server",
  "version": "1.0.0",
  "description": "ArtSlaw AI chatbot backend",
  "license": "AGPL-3.0-only",
  "repository": "github:Febtwenty/artslaw",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "eval": "ts-node --transpile-only -P evals/tsconfig.json evals/run.ts",
    "eval:live": "ts-node --transpile-only -P evals/tsconfig.json evals/run.ts --live",
    "eval:record": "ts-node --transpile-only -P evals/tsconfig.json evals/run.ts --record",
    "eval:baseline": "ts-node --transpile-only -P evals/tsconfig.json evals/run.ts --repeat 3 --write-baseline",
    "eval:judge-sanity": "ts-node --transpile-only -P evals/tsconfig.json evals/judgeSanity.ts",
    "eval:typecheck": "tsc -p evals/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@clerk/express": "^2.0.5",
    "@mistralai/mistralai": "^2.3.0",
    "@types/multer": "^2.1.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "marked": "^18.0.0",
    "mongodb": "^6.21.0",
    "multer": "^2.1.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/sharp": "^0.31.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "zod": "^4.4.3"
  }
}
