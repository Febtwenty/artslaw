# Anthropic API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Mistral API key — get yours at https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# Tavily API key (web search) — get yours from the Tavily dashboard at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Clerk keys (auth) — get yours at https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Optional: comma-separated Clerk user IDs that bypass all token limits
# UNLIMITED_USER_IDS=user_abc123,user_xyz456

# Optional: change the port the Express server listens on (default: 3001)
# PORT=3001

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/artslaw?retryWrites=true&w=majority

# Note: the client needs its own env file — see client/.env.example
